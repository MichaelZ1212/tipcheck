 "cases": {
  "bull": {
   "thesis": "The strongest honest bullish case for AMC is that revenue recovered modestly in the latest reported year and long-term debt was lower than in earlier years. But the available evidence does not support the tip\u2019s $100 target: the stock remains loss-making, cash generation is negative, and the analyst average target is far below that claim.",
   "points": [
    {
     "headline": "Latest revenue edged higher",
     "detail": "Revenue reached $4.8489B in 2025, up 4.6% year over year, after $4.6372B in 2024. This is a modest sign of top-line recovery, not proof of sustained growth.",
     "evidence_ids": [
      "E3"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Debt is below its earlier level",
     "detail": "Long-term debt was $4.0186B in 2025, down from $5.1208B in 2022. The improvement is tempered by $428.5M of cash and negative stockholders\u2019 equity of $1.8948B in 2025.",
     "evidence_ids": [
      "E3"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Recent share performance was positive, but lagged the market",
     "detail": "AMC returned 5.5% over the reported 1-year period, while SPY returned 15.0% over the same dates. AMC\u2019s annualized volatility was 83.9% and its maximum drawdown was -65.5%, showing substantial price swings.",
     "evidence_ids": [
      "E4"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "The $100 target is not substantiated by the available targets",
     "detail": "The analyst mean target is $3.37, with a hold consensus from 6 analysts; the snapshot lists a 52-week high of $3.4. These figures do not establish that $100 is impossible, but they provide no support for that target.",
     "evidence_ids": [
      "E2"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Profit and cash flow remain major hurdles",
     "detail": "AMC reported a net loss of $632.4M and negative operating cash flow of $119.8M in 2025. That weakens the bullish case despite higher revenue and lower long-term debt than in 2022.",
     "evidence_ids": [
      "E3"
     ],
     "unverified_numbers": []
    }
   ],
   "strength": 2
  },
  "bear": {
   "thesis": "The available evidence does not support the tip\u2019s $100 target: AMC remains loss-making and cash-flow negative, with substantial long-term debt and highly volatile shares. The snapshot\u2019s analyst target is far below that claim, although analyst targets are not guarantees and the tools do not establish what AMC\u2019s future share price will be.",
   "points": [
    {
     "headline": "The $100 claim is far above the reported analyst target",
     "detail": "The snapshot reports a mean analyst target of $3.37 from 6 analysts, versus the tip\u2019s $100 claim (E2). That gap does not prove the target impossible, but the provided data offers no support for it.",
     "evidence_ids": [
      "E2"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "AMC continues to report losses",
     "detail": "AMC reported net losses of $632.4M for 2025, following losses of $352.6M in 2024 (E3). The latest reported year-over-year net income growth was -279.4% (E3).",
     "evidence_ids": [
      "E3"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Cash generation and balance-sheet pressure remain concerns",
     "detail": "Operating cash flow was -$119.8M in 2025, and cash was $428.5M at year-end; long-term debt was $4.0186B and stockholders\u2019 equity was -$1.8948B (E3). These figures make a large share-price claim harder to substantiate from the supplied financial data.",
     "evidence_ids": [
      "E3"
     ],
     "unverified_numbers": []
    },
