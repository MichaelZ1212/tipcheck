 "cases": {
  "bull": {
   "thesis": "SoundHound has a credible growth story: revenue nearly doubled in the latest reported year, and its cash balance increased. But it remains loss-making with negative operating cash flow, and the evidence does not support the tip\u2019s assured $50 target or \u201cnext Nvidia\u201d comparison.",
   "points": [
    {
     "headline": "Revenue growth is the strongest point in the tip.",
     "detail": "Revenue rose from $84.693 million in 2024 to $168.920 million in 2025, matching reported year-over-year growth of 99.4%. (E1)",
     "evidence_ids": [
      "E1"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Growth has not yet produced durable profitability or positive cash generation.",
     "detail": "The company reported a net loss of $14.006 million and negative operating cash flow of $98.222 million in 2025. Cash was $248.490 million at year-end. (E1)",
     "evidence_ids": [
      "E1"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "The valuation reflects meaningful risk and does not validate an easy $50 target.",
     "detail": "The snapshot reports price-to-sales of 9.68217 and a mean analyst target of $12.57143 from 7 analysts; neither establishes that the shares will reach $50. (E2)",
     "evidence_ids": [
      "E2"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Recent share performance warns against treating the tip as an easy gain.",
     "detail": "Over the 1-year period, SOUN returned -75.1%, versus 15.0% for the S&P 500 over the same dates; annualized volatility was 69.0%. (E4)",
     "evidence_ids": [
      "E4"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "The social-proof and \u201cnext Nvidia\u201d claims are not established by these data.",
     "detail": "The available company, financial, and price data do not show that group-chat participation predicts results or that SoundHound is comparable to Nvidia. The snapshot reports short interest of 38.96% of float, a sign of substantial disagreement\u2014not confirmation of the tip. (E2)",
     "evidence_ids": [
      "E2"
     ],
     "unverified_numbers": []
    }
   ],
   "strength": 3
  },
  "bear": {
   "thesis": "The tip\u2019s \u201c100%\u201d revenue-growth claim is broadly supported by the latest annual growth figure, but that alone does not establish that SoundHound is \u201cthe next Nvidia\u201d or that a move to $50 is easy. The evidence shows persistent cash outflows, a sharply negative recent share return versus the market, high volatility, and a valuation that leaves meaningful execution risk.",
   "points": [
    {
     "headline": "Revenue growth is real, but does not prove the bigger claims.",
     "detail": "Latest annual revenue growth was 99.4% (E1), close to \u201c100%.\u201d But growth by itself does not establish that SoundHound matches Nvidia or that its shares will reach a particular price; the available evidence cannot verify either claim.",
     "evidence_ids": [
      "E1"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "The company is still losing cash from operations.",
