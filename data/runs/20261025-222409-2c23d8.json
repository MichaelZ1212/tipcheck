 "cases": {
  "bull": {
   "thesis": "AMC has a limited recovery case: revenue grew in the latest year and long-term debt is lower than in earlier filings. But the available evidence does not support the tip\u2019s price target; losses and cash outflows remain, and the average analyst target is far below it.",
   "points": [
    {
     "headline": "Latest-year revenue increased",
     "detail": "Revenue rose 4.6% year over year to $4,848,900,000, a positive sign for a business recovering from weaker operating conditions (E2).",
     "evidence_ids": [
      "E2"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Long-term debt has come down from earlier levels",
     "detail": "Long-term debt was $4,018,600,000 in 2025, down from $5,120,800,000 in 2022. That is progress on debt reduction, though the debt burden remains substantial (E2).",
     "evidence_ids": [
      "E2"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "A low sales multiple may appeal to value-focused investors",
