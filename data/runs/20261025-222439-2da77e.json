 "cases": {
  "bull": {
   "thesis": "The tip has a genuine growth point: SoundHound\u2019s latest reported revenue nearly doubled year over year, and cash increased. But growth alone does not establish that it is \u201cthe next Nvidia\u201d or that the share price will easily reach $50; the available evidence also shows ongoing cash outflow and a sharp one-year decline.",
   "points": [
    {
     "headline": "Revenue nearly doubled in the latest year",
     "detail": "Revenue rose from $84.7M in 2024 to $168.9M in 2025, with reported latest year-over-year growth of 99.4%. That supports the tip\u2019s growth claim, though it does not imply a similar rise in the stock price.",
     "evidence_ids": [
      "E1"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Cash reserves increased, but cash flow stayed negative",
     "detail": "Cash rose to $248.5M in 2025 from $198.2M in 2024, while operating cash flow was negative $98.2M in 2025. The company is growing, but the figures do not yet show operations generating positive cash.",
     "evidence_ids": [
      "E1"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Some analysts are optimistic, but their target is not $50",
     "detail": "The snapshot reports a strong-buy consensus from 7 analysts and a mean analyst target of $12.57. That is a measure of analyst opinion, not a promise of a future price, and it does not support the tip\u2019s $50 claim.",
     "evidence_ids": [
      "E3"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Valuation and trading risk are substantial",
     "detail": "The snapshot reports a price-to-sales ratio of 9.68 and short interest of 38.96% of float. These indicate a richly valued company relative to sales and unusually heavy bets against the shares; neither metric proves what happens next.",
     "evidence_ids": [
      "E3"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Recent share performance contradicts an easy-rise story",
     "detail": "Over the past year, SOUN returned -75.1% while SPY returned 15.0%; its maximum drawdown was -75.8% and annualized volatility was 69.0%. Past performance cannot predict future returns, but this history does not support describing gains as easy or assured.",
     "evidence_ids": [
      "E4"
     ],
     "unverified_numbers": []
    }
   ],
   "strength": 3
  },
  "bear": {
   "thesis": "The tip\u2019s roughly 100% revenue-growth claim is supported by the latest reported year, but that does not establish that SoundHound is \u201cthe next Nvidia\u201d or that it will reach $50. The evidence instead shows large operating cash outflows, a sharp one-year share-price decline, high volatility, and a valuation that leaves little room for disappointment.",
   "points": [
    {
     "headline": "Revenue growth is real, but it is not proof of a sure thing.",
     "detail": "Revenue rose 99.4% year over year in the latest reported year (E1), so the growth claim is broadly supported. But the company still reported a net loss of $14.0M and operating cash flow of -$98.2M in that year (E1).",
     "evidence_ids": [
      "E1"
     ],
     "unverified_numbers": []
    },
    {
     "headline": "Cash generation remains a concern.",
     "detail": "Operating cash flow was negative in each of the four reported fiscal years, including -$98.2M in the latest year (E1). That means reported revenue growth has not yet translated into positive cash generated by operations.",
     "evidence_ids": [
